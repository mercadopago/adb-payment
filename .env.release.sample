# Configuração de release — copie para .env.release e preencha com seus valores
# .env.release está no .gitignore e nunca deve ser commitado

# Host SSH para o repositório interno de desenvolvimento
# Deve estar configurado em ~/.ssh/config com o alias correspondente
# Exemplo: github.com-emu (aponta para github.com com a chave do usuário interno)
SSH_HOST_INTERNAL=github.com-emu

# Caminho para a chave SSH do repositório interno
SSH_KEY_INTERNAL=~/.ssh/id_ed25519

# Caminho para a chave SSH do repositório público
SSH_KEY_PUBLIC=~/.ssh/id_ed25519
